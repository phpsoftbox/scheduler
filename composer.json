{
    "name": "phpsoftbox/scheduler",
    "description": "Scheduler component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "psr/container": "^2.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/queue": "^1.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Scheduler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Scheduler\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-pcntl": "Lets schedule:work stop gracefully on SIGTERM/SIGINT after the current tick.",
        "ext-redis": "Required by RedisScheduleLockStore for atomic distributed scheduler locks",
        "phpsoftbox/cli-app": "Required for schedule:run and schedule:work commands.",
        "phpsoftbox/queue": "Required for onQueue() tasks and SchedulerQueueJobHandler."
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Scheduler\\Cli\\SchedulerCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
